# Copy to .env.local for local overrides. Do not put secrets here: every
# VITE_* value is bundled into the public JavaScript.

# Backend URL used by the Vite dev proxy (npm run dev only).
VITE_DEV_API_TARGET=http://localhost:3000

# Base URL for API calls in the built app. Leave empty when the frontend is
# served from the same origin as the API (e.g. behind the ALB), otherwise set
# it to the ALB DNS name, e.g. http://vaultkeep-alb-123.us-east-1.elb.amazonaws.com
VITE_API_URL=
