# Copy this file to .env for local development. Do not commit .env.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://vaultkeep_user:replace_me@localhost:5432/vaultkeep

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=24h

# AWS Configuration (provisioned by teammate for production; local mock used if empty)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
KMS_KEY_ID=
# For local testing with real AWS (on EC2, IAM Role provides credentials automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

